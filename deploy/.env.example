# Copy to deploy/.env (never commit it).

# Password of the bundled Postgres. It is embedded in a URL, so use URL-safe
# characters only: `openssl rand -hex 24`
POSTGRES_PASSWORD=

# localhost port of the web container; must be free on the host
WEB_PORT=8090

# Docker network of the Caddy container, only with
# docker-compose.caddy-network.yml
# (`docker inspect <caddy-container> --format '{{json .NetworkSettings.Networks}}'`)
CADDY_NETWORK=
