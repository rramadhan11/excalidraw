# Copy to deploy/.env (never commit it).

# Docker network of the Postgres container that is already running
# (`docker inspect <postgres-container> --format '{{json .NetworkSettings.Networks}}'`)
POSTGRES_NETWORK=

# <postgres-container> is that container's name on the network above
DATABASE_URL=postgres://excalidraw:CHANGE_ME@<postgres-container>:5432/excalidraw?sslmode=disable

# localhost port Caddy proxies to; must be free on the VPS
WEB_PORT=8090

# only with docker-compose.caddy-network.yml (Caddy running in Docker)
CADDY_NETWORK=
